<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MiniOS Calculator"
        android:textColor="#00FF9C"
        android:textSize="16sp"
        android:padding="8dp"/>

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#161B22"
        android:text="0"
        android:textColor="#00FF9C"
        android:textSize="48sp"
        android:gravity="end|center_vertical"
        android:padding="16dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/bClear" android:text="C" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bBack"  android:text="⌫" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bPow"   android:text="^" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bDiv"   android:text="/" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/b7" android:text="7" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b8" android:text="8" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b9" android:text="9" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bMul" android:text="*" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/b4" android:text="4" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b5" android:text="5" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b6" android:text="6" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bMinus" android:text="-" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/b1" android:text="1" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b2" android:text="2" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/b3" android:text="3" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bPlus" android:text="+" android:layout_columnWeight="1" android:layout_rowWeight="1"/>

        <Button android:id="@+id/b0" android:text="0" android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bDot" android:text="." android:layout_columnWeight="1" android:layout_rowWeight="1"/>
        <Button android:id="@+id/bEq" android:text="=" android:layout_columnWeight="1" android:layout_rowWeight="1"
                android:layout_columnSpan="2"/>
    </GridLayout>
</LinearLayout>
